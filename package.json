{
  "name": "channels",
  "version": "0.1.0",
  "description": "Multi-channel messaging platform",
  "type": "module",
  "scripts": {
    "dev": "LOG_FORMAT=pretty bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --target=bun --packages=external --production --keep-names --outdir=dist && cp ./src/modules/faq/faq.data.json ./dist/faq.data.json",
    "start": "LOG_FORMAT=json bun run src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "doctor": "node .agents/skills/zaileys/scripts/doctor.mjs .",
    "test": "bun test"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "zaileys": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.7.0"
  }
}
